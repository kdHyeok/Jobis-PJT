#!/usr/bin/env bash
# Deploy immutable JOBISS frontend/backend/AI images and roll back atomically.
set -Eeuo pipefail

readonly APP_ROOT="/opt/jobis"
readonly COMPOSE_FILE="${APP_ROOT}/docker-compose.prod.yml"
readonly COMPOSE_PROJECT="jobis-v2"
readonly STATE_FILE="${APP_ROOT}/.deployed-sha"
readonly LEGACY_BACKEND_STATE="${APP_ROOT}/.legacy-backend-container"
readonly BACKUP_COMMAND="/usr/local/sbin/backup-jobis-db"
readonly NGINX_SWITCH_COMMAND="/usr/local/sbin/switch-jobis-nginx"
readonly AUDIT_COMMAND="/usr/local/sbin/audit-jobis-server"
readonly ENV_FILE="/etc/jobis/jobis-v2.env"
readonly IMAGE_NAMES=(jobis-ai jobis-backend jobis-frontend)
# These units and the original containers are stopped, never deleted here.
readonly LEGACY_UNITS=(jobis-fake-ai.service jobis.service)

if [[ "$EUID" -ne 0 ]]; then
  echo "deploy-jobis must run as root." >&2
  exit 1
fi

readonly RELEASE_SHA="${1:-}"
if [[ ! "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Release SHA must be a 40-character lowercase Git commit SHA." >&2
  exit 1
fi

readonly DEPLOY_ACTOR="${SUDO_USER:-}"
if [[ -z "$DEPLOY_ACTOR" || "$DEPLOY_ACTOR" == "root" ]]; then
  echo "deploy-jobis must be invoked through sudo by the deployment user." >&2
  exit 1
fi

for required_file in "$COMPOSE_FILE" "$BACKUP_COMMAND" "$NGINX_SWITCH_COMMAND" "$AUDIT_COMMAND" "$ENV_FILE"; do
  if [[ ! -f "$required_file" ]]; then
    echo "Required deployment file is missing: $required_file" >&2
    exit 1
  fi
done
for command in "$BACKUP_COMMAND" "$NGINX_SWITCH_COMMAND" "$AUDIT_COMMAND"; do
  if [[ ! -x "$command" ]]; then
    echo "Required deployment command is not executable: $command" >&2
    exit 1
  fi
done

set -a
# Root-owned and mode 0600; values must follow the shell-safe KEY=value format
# documented in .env.production.example.
source "$ENV_FILE"
set +a
readonly IMAGE_PREFIX="${JOBIS_IMAGE_PREFIX:-}"
if [[ -n "$IMAGE_PREFIX" && "$IMAGE_PREFIX" != */ ]]; then
  echo "JOBIS_IMAGE_PREFIX must end with '/': $IMAGE_PREFIX" >&2
  exit 2
fi
if [[ "$IMAGE_PREFIX" == *://* ]]; then
  echo "JOBIS_IMAGE_PREFIX must not include a URL scheme: $IMAGE_PREFIX" >&2
  exit 2
fi

compose() {
  JOBIS_SHA="$1" docker compose --project-name "$COMPOSE_PROJECT" \
    --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "${@:2}"
}

if [[ -n "$IMAGE_PREFIX" ]]; then
  compose "$RELEASE_SHA" pull --quiet
fi

for image in "${IMAGE_NAMES[@]}"; do
  if ! docker image inspect "${IMAGE_PREFIX}${image}:${RELEASE_SHA}" >/dev/null 2>&1; then
    echo "Required image is missing: ${IMAGE_PREFIX}${image}:${RELEASE_SHA}" >&2
    exit 1
  fi
done

readonly PREVIOUS_SHA="$(cat "$STATE_FILE" 2>/dev/null || true)"

compose_up() {
  compose "$1" up -d --no-build
}

wait_for_ai() {
  local response _
  for _ in {1..60}; do
    response="$(curl -fsS http://127.0.0.1:8000/health 2>/dev/null || true)"
    if grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' <<<"$response" &&
       grep -Eq '"service"[[:space:]]*:[[:space:]]*"jobis-ai-v2bridge"' <<<"$response"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_backend() {
  local _
  for _ in {1..60}; do
    if curl -fsS http://127.0.0.1:8080/api/health >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_frontend() {
  local _
  for _ in {1..30}; do
    if curl -fsS http://127.0.0.1:8088/ >/dev/null 2>&1 &&
       curl -fsS http://127.0.0.1:8088/api/auth/csrf >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_stack() {
  wait_for_ai && wait_for_backend && wait_for_frontend
}

wait_for_legacy_ai() {
  local _
  for _ in {1..30}; do
    if curl -fsS -X POST -H 'Content-Type: application/json' \
      -d '{"sourceType":"TEXT","content":"Java Spring Boot PostgreSQL"}' \
      http://127.0.0.1:8000/extract >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_legacy_backend() {
  local _
  for _ in {1..30}; do
    if curl -fsS http://127.0.0.1:8080/health >/dev/null 2>&1 ||
       curl -fsS http://127.0.0.1:8080/api/health >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

restore_initial_containers() {
  local recovery_failed=false legacy_backend="" project=""

  echo "No previous v2 release is available; restoring preserved legacy containers." >&2
  compose "$RELEASE_SHA" down || recovery_failed=true

  if [[ -f "$LEGACY_BACKEND_STATE" ]]; then
    legacy_backend="$(cat "$LEGACY_BACKEND_STATE")"
  fi
  if docker container inspect jobis-backend >/dev/null 2>&1; then
    project="$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' jobis-backend)"
    if [[ "$project" == "$COMPOSE_PROJECT" ]]; then
      echo "Unexpected v2 backend container remains after Compose down." >&2
      recovery_failed=true
    fi
  elif [[ -n "$legacy_backend" ]] && docker container inspect "$legacy_backend" >/dev/null 2>&1; then
    docker rename "$legacy_backend" jobis-backend || recovery_failed=true
  else
    echo "Preserved legacy backend container is unavailable." >&2
    recovery_failed=true
  fi

  if docker container inspect jobis-backend >/dev/null 2>&1; then
    docker start jobis-backend >/dev/null || recovery_failed=true
  fi
  if docker container inspect jobis-fake-ai >/dev/null 2>&1; then
    docker start jobis-fake-ai >/dev/null || recovery_failed=true
  else
    echo "Preserved legacy fake-ai container is unavailable." >&2
    recovery_failed=true
  fi

  "$NGINX_SWITCH_COMMAND" legacy || recovery_failed=true
  wait_for_legacy_ai || recovery_failed=true
  wait_for_legacy_backend || recovery_failed=true

  [[ "$recovery_failed" == false ]]
}

preserve_initial_containers() {
  local project legacy_name suffix unit

  if docker container inspect jobis-backend >/dev/null 2>&1; then
    project="$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' jobis-backend)"
    if [[ "$project" != "$COMPOSE_PROJECT" ]]; then
      suffix="${PREVIOUS_SHA:0:12}"
      [[ "$PREVIOUS_SHA" =~ ^[0-9a-f]{40}$ ]] || suffix="$(date -u +%Y%m%dT%H%M%SZ)"
      legacy_name="jobis-backend-legacy-${suffix}"
      if docker container inspect "$legacy_name" >/dev/null 2>&1; then
        echo "Legacy backend preservation name already exists: $legacy_name" >&2
        return 1
      fi
      docker stop jobis-backend >/dev/null
      docker rename jobis-backend "$legacy_name"
      printf '%s\n' "$legacy_name" >"$LEGACY_BACKEND_STATE"
    fi
  fi
  if docker container inspect jobis-fake-ai >/dev/null 2>&1; then
    docker stop jobis-fake-ai >/dev/null 2>&1 || true
  fi
  for unit in "${LEGACY_UNITS[@]}"; do
    systemctl stop "$unit" >/dev/null 2>&1 || true
    systemctl disable "$unit" >/dev/null 2>&1 || true
  done
}

rollback() {
  local exit_code=$? image rollback_ready=true
  trap - ERR HUP INT TERM
  echo "Deployment failed. Rolling back." >&2

  if [[ ! "$PREVIOUS_SHA" =~ ^[0-9a-f]{40}$ ]]; then
    rollback_ready=false
  else
    if [[ -n "$IMAGE_PREFIX" ]]; then
      compose "$PREVIOUS_SHA" pull --quiet || rollback_ready=false
    fi
    for image in "${IMAGE_NAMES[@]}"; do
      docker image inspect "${IMAGE_PREFIX}${image}:${PREVIOUS_SHA}" >/dev/null 2>&1 || rollback_ready=false
    done
  fi

  if [[ "$rollback_ready" == true ]]; then
    if compose_up "$PREVIOUS_SHA" &&
       wait_for_stack &&
       "$NGINX_SWITCH_COMMAND" container; then
      printf '%s\n' "$PREVIOUS_SHA" >"$STATE_FILE"
      echo "Image rollback completed: $PREVIOUS_SHA" >&2
    else
      rollback_ready=false
    fi
  fi

  if [[ "$rollback_ready" != true ]] && ! restore_initial_containers; then
    echo "Automatic rollback failed; manual recovery is required." >&2
  fi

  exit "$exit_code"
}
# A deploy is not allowed to be the first time a backup path is tested.
JOBIS_ENV_FILE="$ENV_FILE" "$BACKUP_COMMAND" "$RELEASE_SHA"

trap rollback ERR HUP INT TERM

# Preserve the original containers only after images and backup are verified.
preserve_initial_containers

compose_up "$RELEASE_SHA"
wait_for_stack
"$NGINX_SWITCH_COMMAND" container
"$AUDIT_COMMAND" "$RELEASE_SHA" postdeploy

printf '%s\n' "$RELEASE_SHA" >"$STATE_FILE"
trap - ERR HUP INT TERM

echo "Deployment completed successfully: $RELEASE_SHA"
echo "Legacy containers and images remain preserved for explicit later cleanup."
