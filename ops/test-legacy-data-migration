INSERT INTO saved_roadmaps VALUES
  (80, 'analysis-complete', '2026-01-06 10:00:00', '백엔드 취업', true, '{"stages":[{"title":"기초"}]}', 'route-a', 1);
SQL

while IFS= read -r migration; do
  docker exec -i "$CONTAINER" psql -U jobiss_migrator -d jobiss_v2 -v ON_ERROR_STOP=1 \
    <"$migration" >/dev/null
done < <(find backend/src/main/resources/db/migration -maxdepth 1 -type f -name 'V*.sql' | sort -V)

docker exec -i "$CONTAINER" psql -U jobiss_migrator -d jobiss_v2 -v ON_ERROR_STOP=1 <<'SQL' >/dev/null
CREATE TABLE flyway_schema_history(version varchar(50), success boolean);
INSERT INTO flyway_schema_history VALUES ('27', true);
SQL

docker exec -u 0 "$CONTAINER" mkdir -p /opt/jobis
docker cp ops/migrate-jobis-legacy-to-v2 "$CONTAINER:/usr/local/sbin/migrate-jobis-legacy-to-v2" >/dev/null
docker cp ops/migrate-jobis-legacy-to-v2.sql "$CONTAINER:/opt/jobis/migrate-jobis-legacy-to-v2.sql" >/dev/null
docker exec -u 0 "$CONTAINER" bash -ec '
  chmod 0755 /usr/local/sbin/migrate-jobis-legacy-to-v2
  chmod 0644 /opt/jobis/migrate-jobis-legacy-to-v2.sql
  mkdir -p /mnt/jobis-backups/legacy-db /mnt/jobis-backups/service-db
  touch /mnt/jobis-backups/legacy-db/jobiss-test.dump
  touch /mnt/jobis-backups/service-db/jobiss_v2-test.dump
  /usr/local/sbin/migrate-jobis-legacy-to-v2
' >/dev/null

counts="$(docker exec "$CONTAINER" psql -U postgres -d jobiss_v2 -At -F ':' -v ON_ERROR_STOP=1 -c \
  "select (select count(*) from users), (select count(*) from job_postings), (select count(*) from conversations), (select count(*) from conversation_messages), (select count(*) from analysis_jobs), (select count(*) from career_sources), (select count(*) from evidence), (select count(*) from roadmap_versions), (select count(*) from legacy_import_audit)")"
legacy_counts="$(docker exec "$CONTAINER" psql -U postgres -d jobiss -At -F ':' -v ON_ERROR_STOP=1 -c \
  "select (select count(*) from users), (select count(*) from job_postings), (select count(*) from analysis_runs)")"

if [[ "$counts" != "1:1:1:2:2:1:1:1:1" || "$legacy_counts" != "1:2:2" ]]; then
  echo "Legacy migration count validation failed: target=$counts legacy=$legacy_counts" >&2
  exit 1
fi
if docker exec -u 0 "$CONTAINER" /usr/local/sbin/migrate-jobis-legacy-to-v2 >/dev/null 2>&1; then
  echo "A repeated legacy import was not rejected." >&2
  exit 1
fi

echo "legacy-data-migration-ci: ok"
