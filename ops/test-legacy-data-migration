INSERT INTO resume_documents VALUES
  (60, 'Java와 Spring Boot 프로젝트 경험이 있는 이력 자료입니다.', '2026-01-05 10:00:00', NULL, 'TEXT', NULL, '기존 이력', '2026-01-05 11:00:00', 1);
INSERT INTO evidences VALUES
