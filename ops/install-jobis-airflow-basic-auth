#!/usr/bin/env bash
# Airflow UI(/airflow) 앞단 basic auth 자격증명을 만든다.
#
# Airflow 로그인 화면 자체가 공개 도메인에 노출되는 것을 막기 위한 한 겹이다.
# 생성한 비밀번호는 화면에 찍지 않고 root 전용 파일에 남긴다.
#
#   sudo ops/install-jobis-airflow-basic-auth [사용자명]
#   sudo cat /etc/jobis/airflow-basic-auth.credentials   # 확인
set -Eeuo pipefail

readonly HTPASSWD_FILE="/etc/nginx/.htpasswd-airflow"
readonly CREDENTIALS_FILE="/etc/jobis/airflow-basic-auth.credentials"
readonly AUTH_USER="${1:-jobis}"

if [[ "$EUID" -ne 0 ]]; then
  echo "install-jobis-airflow-basic-auth must run as root." >&2
  exit 1
fi

for command in htpasswd openssl nginx; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "Required command is missing: $command (apache2-utils 필요)" >&2
    exit 1
  }
done

if [[ ! "$AUTH_USER" =~ ^[A-Za-z0-9_-]{1,32}$ ]]; then
  echo "사용자명은 영숫자, 밑줄, 하이픈 32자 이내여야 한다: $AUTH_USER" >&2
  exit 2
fi

password="$(openssl rand -base64 18 | tr -d '/+=' | head -c 20)"

# -c 는 파일을 새로 만든다. 기존 사용자를 유지하려면 파일이 있을 때 -c 를 빼야 한다.
if [[ -f "$HTPASSWD_FILE" ]]; then
  htpasswd -bB "$HTPASSWD_FILE" "$AUTH_USER" "$password" >/dev/null
else
  htpasswd -cbB "$HTPASSWD_FILE" "$AUTH_USER" "$password" >/dev/null
fi

# nginx 워커가 읽어야 하므로 그룹 읽기까지만 허용한다.
chown root:www-data "$HTPASSWD_FILE"
chmod 640 "$HTPASSWD_FILE"

umask 077
printf 'Airflow nginx basic auth\nusername: %s\npassword: %s\n' \
  "$AUTH_USER" "$password" >"$CREDENTIALS_FILE"
chmod 600 "$CREDENTIALS_FILE"

nginx -t
echo "basic auth 자격증명을 만들었다. 값 확인: sudo cat $CREDENTIALS_FILE"
