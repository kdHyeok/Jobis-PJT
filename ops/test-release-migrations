#!/usr/bin/env bash
# 릴리스 마이그레이션을 **운영의 현재 상태**에 적용해보는 사전 검사.
#
# 왜 필요한가 (실측: master #9, 2026-08-08)
#   CI 는 항상 빈 PostgreSQL 에서 마이그레이션을 검증한다. 빈 DB 에는 적용 이력이
#   없으므로 "이미 적용된 버전과 어긋난다"는 종류의 결함은 구조적으로 걸리지 않는다.
#   실제로 통합 브랜치가 운영에 이미 적용된 V20~V28 을 삭제·재번호했는데 develop CI 는
#   끝까지 초록이었고, 배포 시점에 backend 가 뜨지 못해 롤백됐다.
#
#   이 검사는 최신 운영 덤프를 일회용 PostgreSQL 에 복원한 뒤 릴리스의 마이그레이션을
#   그대로 돌린다. 배포 전에 같은 실패를 재현하는 것이 목적이다.
#
# 운영 DB 는 읽지도 쓰지도 않는다. 덤프 파일만 읽고 격리된 컨테이너에서만 작업한다.
#
# usage: test-release-migrations [/absolute/path/to/migration/dir]
#   인자를 주지 않으면 이 저장소의 backend/src/main/resources/db/migration 을 쓴다.
set -Eeuo pipefail

readonly ENV_FILE="${JOBIS_ENV_FILE:-/etc/jobis/jobis-v2.env}"
readonly FLYWAY_IMAGE="${JOBIS_FLYWAY_IMAGE:-flyway/flyway:11-alpine}"
readonly POSTGRES_IMAGE="${JOBIS_POSTGRES_IMAGE:-postgres:17-alpine}"

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
migration_dir="${1:-${script_dir}/../backend/src/main/resources/db/migration}"
if [[ ! -d "$migration_dir" ]]; then
  echo "Migration directory is missing: $migration_dir" >&2
  exit 2
fi
migration_dir="$(cd -- "$migration_dir" && pwd)"

# 두 곳에서 쓴다.
#   1) Jenkins 'Release migration gate' 스테이지 — JOBIS_BACKUP_DIR 를 직접 주고 워크스페이스의
#      마이그레이션 디렉터리를 인자로 넘긴다. 운영 env 파일을 읽지 않는다.
#   2) 서버에서 수동 실행 — env 파일에서 JOBIS_BACKUP_DIR 를 읽는다.
if [[ -z "${JOBIS_BACKUP_DIR:-}" ]]; then
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "JOBIS_BACKUP_DIR 도 없고 환경 파일도 없다: $ENV_FILE" >&2
    exit 1
  fi
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

readonly BACKUP_DIR="${JOBIS_BACKUP_DIR:-/var/backups/jobis/service-db}"
if [[ ! -d "$BACKUP_DIR" ]]; then
  echo "Backup directory is missing: $BACKUP_DIR" >&2
  exit 1
fi

latest=""
shopt -s nullglob
for candidate in "$BACKUP_DIR"/*.dump; do
  if [[ -z "$latest" || "$candidate" -nt "$latest" ]]; then
    latest="$candidate"
  fi
done
shopt -u nullglob

if [[ -z "$latest" ]]; then
  echo "No service DB dump is available to test migrations against." >&2
  exit 1
fi
if [[ -L "$latest" ]]; then
  echo "Refusing a symbolic-link dump file: $latest" >&2
  exit 2
fi

checksum_file="${latest}.sha256"
if [[ -f "$checksum_file" ]]; then
  (cd -- "$(dirname -- "$latest")" && sha256sum --check "$(basename -- "$checksum_file")")
else
  echo "Checksum file is missing: $checksum_file" >&2
  exit 2
fi

echo "[release-migrations] dump=$(basename -- "$latest")"

container="jobis-release-migration-test-$$"
cleanup() {
  docker rm -f "$container" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# 외부 네트워크 없이 띄운다. Flyway 컨테이너는 이 컨테이너의 네트워크 네임스페이스를
# 공유해 127.0.0.1 로 붙으므로 포트를 호스트에 노출하지 않는다.
docker run -d \
  --name "$container" \
  --network none \
  -e POSTGRES_PASSWORD=migration-drill-only \
  "$POSTGRES_IMAGE" >/dev/null

ready=false
for _ in {1..30}; do
  if docker exec "$container" \
    pg_isready -h 127.0.0.1 -U postgres -d postgres >/dev/null 2>&1; then
    ready=true
    break
  fi
  sleep 1
done
if [[ "$ready" != true ]]; then
  echo "Disposable PostgreSQL did not become ready." >&2
  exit 1
fi

docker exec -i "$container" pg_restore \
  --username postgres \
  --dbname postgres \
  --no-owner \
  --no-privileges \
  --exit-on-error <"$latest"

applied_before="$(docker exec "$container" psql -U postgres -d postgres -At -v ON_ERROR_STOP=1 -c \
  "select count(*) from flyway_schema_history where success")"
echo "[release-migrations] restored history entries: ${applied_before}"

# Flyway 를 같은 네트워크 네임스페이스에서 돌린다. validate 는 migrate 전에 이미 적용된
# 버전과 로컬 파일(버전·설명·체크섬)이 일치하는지 본다 — 이번 사고가 걸리는 지점이다.
migration_status=0
docker run --rm \
  --network "container:${container}" \
  -v "${migration_dir}:/flyway/sql:ro" \
  "$FLYWAY_IMAGE" \
  -url=jdbc:postgresql://127.0.0.1:5432/postgres \
  -user=postgres \
  -password=migration-drill-only \
  -locations=filesystem:/flyway/sql \
  -connectRetries=10 \
  migrate || migration_status=$?

if [[ "$migration_status" -ne 0 ]]; then
  echo >&2
  echo "release-migrations FAILED: 이 릴리스는 운영의 현재 스키마에 적용되지 않는다." >&2
  echo "배포하면 backend 가 기동하지 못하고 롤백된다. 마이그레이션을 먼저 조정할 것." >&2
  exit 1
fi

applied_after="$(docker exec "$container" psql -U postgres -d postgres -At -v ON_ERROR_STOP=1 -c \
  "select count(*) from flyway_schema_history where success")"

echo "[release-migrations] status=completed applied=${applied_before}->${applied_after}"
