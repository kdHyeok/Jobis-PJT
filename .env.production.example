# Application database on the deployment host. Keep PostgreSQL loopback-only.
DB_URL=jdbc:postgresql://127.0.0.1:5432/jobiss_v2
DB_MIGRATOR_USER=jobiss_migrator
DB_MIGRATOR_PASSWORD=replace-with-a-long-random-password
DB_APP_USER=jobiss_app
DB_APP_PASSWORD=replace-with-a-different-long-random-password

# Include the trailing slash. This is required when Jenkins and the deployment
# host do not share one Docker daemon. Leave empty only for a same-host setup.
JOBIS_IMAGE_PREFIX=registry.example.com/group/project/

JWT_SECRET=replace-with-at-least-32-random-bytes
AI_SHARED_SECRET=replace-with-at-least-32-random-bytes
AI_HTTP_TIMEOUT_SECONDS=660
AI_MAX_CONCURRENT_ANALYSES=2
AI_SERVER_URL=http://127.0.0.1:8000

# Production LLM. Codex OAuth state is stored outside the container under
# /var/lib/jobis-ai/codex and must be initialized once on the server.
LLM_PROVIDER=codex
CODEX_MODEL=gpt-5.4
CODEX_MODEL_LIGHT=gpt-5.4
CODEX_MODEL_ROUTER=
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SEC=200

# Alternative API providers. Leave unused secrets empty.
GMS_KEY=
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_MODEL_LIGHT=gpt-4.1-mini
LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

RAG_PROVIDER=http
RAG_SEARCH_URL=http://127.0.0.1:8765

# Host PostgreSQL databases used by Airflow and pgvector RAG. The bootstrap
# scripts generate the real passwords and complete DSNs without printing them.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace-with-a-long-random-password
AIRFLOW_DB_DSN=postgresql+psycopg2://airflow:replace-with-a-long-random-password@127.0.0.1:5432/airflow
# 관리자 계정명은 추측하기 쉬운 admin 을 피한다. airflow-init 이 이 이름으로
# 계정 존재 여부를 확인하므로, 운영에서 이름을 바꾸면 여기도 함께 바꿔야
# 다음 배포 때 옛 계정이 다시 만들어지지 않는다.
AIRFLOW_ADMIN_USERNAME=replace-with-a-non-obvious-username
AIRFLOW_ADMIN_EMAIL=replace-with-an-admin-email
AIRFLOW_ADMIN_PASSWORD=replace-with-a-long-random-password
AIRFLOW_FERNET_KEY=replace-with-a-valid-fernet-key
# Flask 세션 서명 키. 워커마다 키가 달라지면 로그인이 임의로 풀리므로 반드시 고정한다.
# 값을 바꾸면 기존 로그인 세션이 모두 무효가 된다: openssl rand -base64 42
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-long-random-secret
# Nginx 가 /airflow 로 프록시하므로 공개 도메인과 경로 접두사를 함께 적는다.
# 접두사(/airflow)를 빼면 UI 링크와 정적 자원이 루트로 향해 화면이 깨진다.
AIRFLOW_BASE_URL=https://replace-with-your-domain/airflow
JOBRAG_DB_USER=jobrag
JOBRAG_DB_PASSWORD=replace-with-a-different-long-random-password
JOBRAG_PG_DSN=postgresql://jobrag:replace-with-a-different-long-random-password@127.0.0.1:5432/jobrag
JOBRAG_FLYWAY_URL=jdbc:postgresql://127.0.0.1:5432/jobrag
DOCKER_GID=999

# RAG model and resource limits. Switch both providers to gms and set GMS_KEY
# only when the operating budget permits API-backed indexing/search.
RAG_EMBED_PROVIDER=local
RAG_RERANK_PROVIDER=local
RAG_LOCAL_EMBED_MODEL=BAAI/bge-m3
RAG_GMS_EMBED_MODEL=text-embedding-3-large
RAG_LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_GMS_RERANK_MODEL=gpt-4.1-mini
RAG_VECTOR_DIMENSIONS=1024
RAG_LOCAL_CPU_THREADS=2
RAG_INGEST_CPUS=2.0
RAG_SEARCH_CPUS=2.0
RAG_EMBED_BATCH_SIZE=8
RAG_INGEST_WINDOW_SIZE=64
RAG_LOCAL_RERANK_BATCH_SIZE=4
RAG_GMS_OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
RAG_GMS_TIMEOUT_SECONDS=60
RAG_GMS_MAX_RETRIES=2
RAG_GMS_RERANK_BATCH_SIZE=30
RAG_GMS_RERANK_MAX_CHARS=1800

ALLOWED_ORIGINS=https://jobiss.example.com
COOKIE_SECURE=true
SPRING_PROFILES_ACTIVE=prod
JOBISS_HTTP_PORT=8088

# Put this path on a separate disk, NAS, or object-storage-backed mount.
JOBIS_BACKUP_DIR=/mnt/jobis-backups/service-db
JOBIS_PIPELINE_BACKUP_DIR=/mnt/jobis-backups/pipeline-db
JOBIS_BACKUP_RETENTION_DAYS=14
# Keep 'host' while PostgreSQL listens only on the deployment host loopback.
JOBIS_BACKUP_DOCKER_NETWORK=host
# Refuse CD backups that share the application filesystem.
JOBIS_BACKUP_REQUIRE_SEPARATE_FILESYSTEM=true
JOBIS_REQUIRE_LEGACY_IMPORT=true

# --- 이 브랜치가 추가한 백엔드 설정 -------------------------------------------
# 새 기능(민감정보 암호화, 회전 refresh 토큰, 비밀번호 재설정 메일, 저장소 연동)이
# 요구한다. 값을 비우면 애플리케이션 기본값(로컬 개발용)이 그대로 프로덕션에 쓰이므로
# 반드시 교체한다.
SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-a-separate-32-byte-random-encryption-key
SENSITIVE_DATA_FINGERPRINT_KEY=replace-with-a-different-32-byte-random-hmac-key
REPOSITORY_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-32-byte-random-secret
ACCESS_TOKEN_SECONDS=7200
REFRESH_TOKEN_SECONDS=1209600
REMEMBER_ME_REFRESH_TOKEN_SECONDS=2592000

# 비밀번호 재설정 링크가 가리키는 공개 주소와 전송 채널.
PUBLIC_APP_URL=https://jobiss.example.com
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_CONSOLE_DELIVERY=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@jobiss.example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
