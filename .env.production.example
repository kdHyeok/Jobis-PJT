POSTGRES_DB=jobiss
POSTGRES_MIGRATOR_USER=jobiss_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-long-random-password
POSTGRES_APP_USER=jobiss_app
POSTGRES_APP_PASSWORD=replace-with-a-different-long-random-password

JWT_SECRET=replace-with-at-least-32-random-bytes
AI_SHARED_SECRET=replace-with-at-least-32-random-bytes
AI_HTTP_TIMEOUT_SECONDS=660
AI_REQUEST_TIMEOUT_SECONDS=600
AI_PROGRESS_LOG_INTERVAL_SECONDS=10
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

ALLOWED_ORIGINS=https://jobiss.example.com
COOKIE_SECURE=true
SPRING_PROFILES_ACTIVE=prod
JOBISS_AI_ENVIRONMENT=production
JOBISS_AI_ANALYSIS_PROVIDER=anthropic
JOBISS_HTTP_PORT=8088
