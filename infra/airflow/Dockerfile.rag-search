FROM python:3.11-slim

WORKDIR /app

COPY RAG/requirements.txt .
RUN sed 's/"//g' requirements.txt > /tmp/requirements.txt \
    && pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r /tmp/requirements.txt

COPY RAG/ .

ENV HF_HOME=/hf \
    PYTHONUNBUFFERED=1

EXPOSE 8765

CMD ["python", "-m", "uvicorn", "webapp.tool_server:app", "--host", "0.0.0.0", "--port", "8765"]
