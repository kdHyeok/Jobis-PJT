# cp .env.example .env 후 전부 실제 값으로 교체할 것. .env는 git에 올리지 않는다.
POSTGRES_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
JOBRAG_DB_PASSWORD=change-me
# 평소에는 jobrag. 복구 시 새 DB로 검증 후 전환할 때만 변경한다.
JOBRAG_DB_NAME=jobrag
AIRFLOW_ADMIN_PASSWORD=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change-me
# getent group docker | cut -d: -f3
DOCKER_GID=999

# RAG 모델 provider. 현재 구현과 동일한 기본값은 local이다.
# 운영 서버에서 GMS를 쓰려면 아래 두 provider만 gms로 바꾸고 GMS_KEY를 채운다.
RAG_EMBED_PROVIDER=local
RAG_RERANK_PROVIDER=local

# provider별 모델. provider를 바꿀 때 모델명까지 다시 수정하지 않아도 된다.
RAG_LOCAL_EMBED_MODEL=BAAI/bge-m3
RAG_GMS_EMBED_MODEL=text-embedding-3-large
RAG_LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_GMS_RERANK_MODEL=gpt-4.1-mini

# 현재 pgvector 스키마가 VECTOR(1024)이므로 1024만 허용한다.
# GMS text-embedding-3 계열 호출에도 dimensions=1024로 전달된다.
RAG_VECTOR_DIMENSIONS=1024

# 로컬 모델 자원 제한. 4 vCPU 서버에서 나머지 서비스용 CPU를 남기는 기준값이다.
# 적재·검색 컨테이너 모두 2 CPU 하드 쿼터와 라이브러리 스레드 제한을 적용한다.
RAG_LOCAL_CPU_THREADS=2
RAG_INGEST_CPUS=2.0
RAG_SEARCH_CPUS=2.0
RAG_EMBED_BATCH_SIZE=8
RAG_INGEST_WINDOW_SIZE=64
RAG_LOCAL_RERANK_BATCH_SIZE=4

# GMS OpenAI 호환 API. local/local 조합에서는 GMS_KEY가 비어 있어도 된다.
GMS_KEY=
RAG_GMS_OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
RAG_GMS_TIMEOUT_SECONDS=60
RAG_GMS_MAX_RETRIES=2
RAG_GMS_RERANK_BATCH_SIZE=30
RAG_GMS_RERANK_MAX_CHARS=1800

# 리랭킹만 끄려면 RAG_RERANK_PROVIDER=none 으로 설정한다.
# 운영 GMS 예시:
# RAG_EMBED_PROVIDER=gms
# RAG_RERANK_PROVIDER=gms
# GMS_KEY=<발급받은 값>

# 일회성 jobis_legacy_import 입력. docker-compose.yml 기준 상대 경로 또는 절대 경로.
JOBIS_LEGACY_SQLITE_PATH=../../RAG/Jobis_통합본_20260728/Jobis_통합본_20260728/all_job_postings.db
