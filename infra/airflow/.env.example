# cp .env.example .env 후 전부 실제 값으로 교체할 것. .env는 git에 올리지 않는다.
POSTGRES_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
JOBRAG_DB_PASSWORD=change-me
# 평소에는 jobrag. 복구 시 새 DB로 검증 후 전환할 때만 변경한다.
JOBRAG_DB_NAME=jobrag
AIRFLOW_ADMIN_PASSWORD=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change-me
# getent group docker | cut -d: -f3
DOCKER_GID=999
# 일회성 jobis_legacy_import 입력. docker-compose.yml 기준 상대 경로 또는 절대 경로.
JOBIS_LEGACY_SQLITE_PATH=../../RAG/Jobis_통합본_20260728/Jobis_통합본_20260728/all_job_postings.db
