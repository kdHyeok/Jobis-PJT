# Airflow 이미지: DATA/ 크롤러 포함 (표준 라이브러리만 사용하므로 추가 pip 의존성 없음).
# 빌드 컨텍스트는 저장소 루트 (docker-compose.yml에서 지정).
FROM apache/airflow:2.11.0-python3.11

USER root
# psql: export_postgres.py가 만든 SQL을 job_postings 테이블에 적재할 때 사용
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*
USER airflow

# DockerOperator (rag_ingest 태스크)
RUN pip install --no-cache-dir apache-airflow-providers-docker

COPY --chown=airflow:root DATA/ /opt/jobis/DATA/
# 볼륨 마운트 지점을 airflow 소유로 미리 생성 — 빈 네임드 볼륨은 이미지 쪽
# 소유권을 물려받으므로, 이게 없으면 마운트 디렉토리가 root 소유가 돼 크롤러가 못 쓴다
RUN mkdir -p /opt/jobis/DATA/data /opt/jobis/DATA/exports
