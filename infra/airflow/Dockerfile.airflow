# Airflow 이미지: DATA/ 크롤러와 OCR 실행 환경 포함.
# 빌드 컨텍스트는 저장소 루트 (docker-compose.yml에서 지정).
FROM apache/airflow:2.11.0-python3.11

USER root
# PaddleOCR의 큰 의존성 그래프가 Airflow 패키지를 덮어쓰지 않도록 별도 venv에 격리한다.
# 크롤·병합 태스크는 Airflow의 기본 Python을, OCR 태스크만 이 Python을 사용한다.
COPY DATA/requirements.txt /tmp/data-requirements.txt
RUN python -m venv /opt/jobis/ocr-venv \
    && /opt/jobis/ocr-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/jobis/ocr-venv/bin/pip install --no-cache-dir -r /tmp/data-requirements.txt \
    && rm /tmp/data-requirements.txt

# psql: export_postgres.py가 만든 SQL을 job_postings 테이블에 적재할 때 사용
# libgl1/libglib2.0-0: PaddleOCR가 불러오는 OpenCV 런타임
# libgomp1: PaddlePaddle CPU 코어의 OpenMP 런타임
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-client libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/jobis/imports \
    && chown airflow:root /opt/jobis/imports
USER airflow

# DockerOperator (rag_ingest 태스크)
RUN pip install --no-cache-dir apache-airflow-providers-docker

COPY --chown=airflow:root DATA/ /opt/jobis/DATA/
# 볼륨 마운트 지점을 airflow 소유로 미리 생성 — 빈 네임드 볼륨은 이미지 쪽
# 소유권을 물려받으므로, 이게 없으면 마운트 디렉토리가 root 소유가 돼 크롤러가 못 쓴다
RUN mkdir -p /opt/jobis/DATA/data /opt/jobis/DATA/exports \
    /home/airflow/.paddlex /home/airflow/.paddleocr
