# Docker 를 쓰지 않고 scripts/ 로 각 서비스를 직접 띄울 때의 예제.
# Docker 로 실행한다면 이 파일이 아니라 .env.compose-local.example 을 복사한다.
#   로컬 PostgreSQL: scripts/start-local-postgres.ps1 (58432)
#   JOBIS AI:        scripts/start-ai-agent.ps1        (8400)
#   backend:         scripts/start-backend.ps1         (SERVER_PORT, 기본 8080)
#   frontend:        scripts/start-frontend.ps1        (5473)
# AI/src/jobis_ai/config.py 는 AI/.env 가 아니라 이 루트 .env 를 읽는다.

POSTGRES_DB=jobiss
POSTGRES_MIGRATOR_USER=jobiss_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_APP_USER=jobiss_app
POSTGRES_APP_PASSWORD=change-me-app

# Spring Boot database connection. 포트는 scripts/start-local-postgres.ps1 의 격리 포트다.
DB_URL=jdbc:postgresql://localhost:58432/jobiss
DB_MIGRATOR_USER=jobiss_migrator
DB_MIGRATOR_PASSWORD=change-me-migrator
DB_APP_USER=jobiss_app
DB_APP_PASSWORD=change-me-app

# 애플리케이션 기본값은 compose 계약과 같은 8080 이다(2026-08-08 복원).
# 다른 스택과 겹치면 여기서 바꾼다.
SERVER_PORT=8080

JWT_SECRET=replace-with-at-least-32-random-characters
AI_SERVER_URL=http://localhost:8400
AI_SHARED_SECRET=replace-with-a-random-internal-secret
AI_HTTP_TIMEOUT_SECONDS=660
AI_MAX_CONCURRENT_ANALYSES=2

# Frontend dev server proxies /api to the backend by default.
VITE_API_BASE_URL=
PUBLIC_APP_URL=http://localhost:5473

# AI/v2bridge. 팀 표준 프로바이더는 Anthropic API 직접 호출이다(D140).
# start-ai-agent.ps1 은 이 값을 존중하고, 비어 있을 때만 anthropic 으로 기본값을 깐다.
# 고급/경량/라우터 3티어를 쓴다. _LIGHT·_ROUTER 를 비우면 고급 티어로 폴백한다.
JOBISS_AI_SHARED_SECRET=replace-with-a-random-internal-secret
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_ROUTER=

# 다른 provider 로 바꿀 때만 채운다: openai(GMS) | claude_code | codex(OAuth) | codex_cli
GMS_KEY=
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_MODEL_LIGHT=gpt-4.1-mini
LLM_MAX_TOKENS=4096
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_MODEL_LIGHT=haiku
CODEX_MODEL=gpt-5.4
CODEX_MODEL_LIGHT=gpt-5.4
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SEC=200

# RAG 검색. infra/airflow 묶음을 띄웠을 때만 http 로 바꾼다.
RAG_PROVIDER=null
RAG_SEARCH_URL=http://127.0.0.1:8765

# URL source acquisition fallbacks. Direct HTML/iframe collection runs first;
# these providers are only used when the exact posting URL is still incomplete.
JOBIS_JINA_ENABLED=true
JINA_API_KEY=
JOBIS_FIRECRAWL_ENABLED=true
FIRECRAWL_API_KEY=
JOBIS_TAVILY_ENABLED=true
TAVILY_API_KEY=

# 이미지 기반 공고 OCR/VLM. 키가 없으면 비활성이다.
CLOVA_API_KEY=
CLOVA_VLM_URL=https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005

# 세션 쿠키 이름. 같은 localhost 에 스택을 병렬로 띄우면(다른 브랜치 등) 쿠키가
# 서로를 덮어 로그인이 풀린다 — 스택마다 다른 이름을 주면 충돌이 불가능해진다.
# AUTH_COOKIE_NAME=jobiss_access
