POSTGRES_DB=jobiss_real_agent_lab
POSTGRES_MIGRATOR_USER=jobiss_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_APP_USER=jobiss_app
POSTGRES_APP_PASSWORD=change-me-app

# Spring Boot database connection
DB_URL=jdbc:postgresql://localhost:57432/jobiss_real_agent_lab
DB_MIGRATOR_USER=jobiss_migrator
DB_MIGRATOR_PASSWORD=change-me-migrator
DB_APP_USER=jobiss_app
DB_APP_PASSWORD=change-me-app

JWT_SECRET=replace-with-at-least-32-random-characters
SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-a-separate-random-encryption-key
SENSITIVE_DATA_FINGERPRINT_KEY=replace-with-a-different-random-hmac-key
ACCESS_TOKEN_SECONDS=7200
REFRESH_TOKEN_SECONDS=1209600
REMEMBER_ME_REFRESH_TOKEN_SECONDS=2592000
AI_SERVER_URL=http://localhost:8200
AI_SHARED_SECRET=replace-with-a-random-internal-secret
AI_HTTP_TIMEOUT_SECONDS=660
AI_MAX_CONCURRENT_ANALYSES=2
REPOSITORY_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-random-encryption-key
PUBLIC_APP_URL=http://localhost:5373
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_CONSOLE_DELIVERY=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@jobis.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# Frontend dev server uses port 5373 and proxies /api to localhost:8280 by default.
VITE_API_BASE_URL=

# Real multi-agent bridge. Use GMS/OpenAI, Anthropic, or the signed-in
# Claude Code CLI supported by AI/src/jobis_ai.
JOBISS_AI_SHARED_SECRET=replace-with-a-random-internal-secret
LLM_PROVIDER=claude_code
CLAUDE_CLI=claude
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_MODEL_LIGHT=haiku
GMS_KEY=
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
RAG_PROVIDER=null
RAG_SEARCH_URL=http://127.0.0.1:8870
