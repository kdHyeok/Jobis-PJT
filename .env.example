POSTGRES_DB=jobiss
POSTGRES_MIGRATOR_USER=jobiss_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_APP_USER=jobiss_app
POSTGRES_APP_PASSWORD=change-me-app

# Spring Boot database connection
DB_URL=jdbc:postgresql://localhost:55432/jobiss
DB_MIGRATOR_USER=jobiss_migrator
DB_MIGRATOR_PASSWORD=change-me-migrator
DB_APP_USER=jobiss_app
DB_APP_PASSWORD=change-me-app

JWT_SECRET=replace-with-at-least-32-random-characters
AI_SERVER_URL=http://localhost:8000
AI_SHARED_SECRET=replace-with-a-random-internal-secret
AI_HTTP_TIMEOUT_SECONDS=660
AI_MAX_CONCURRENT_ANALYSES=2

# Frontend dev server proxies /api to localhost:8080 by default.
VITE_API_BASE_URL=

# AI server. Local development can use the signed-in Claude CLI.
JOBISS_AI_ENVIRONMENT=local
JOBISS_AI_ANALYSIS_PROVIDER=claude_cli
JOBISS_AI_SHARED_SECRET=replace-with-a-random-internal-secret
JOBISS_AI_CLAUDE_CLI_MODEL=sonnet
JOBISS_AI_REQUEST_TIMEOUT_SECONDS=600
JOBISS_AI_PROGRESS_LOG_INTERVAL_SECONDS=10
JOBISS_AI_MAX_CONCURRENCY=2

# Production uses the Anthropic API provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
