# === 개인 값만 채우면 되는 칸 (이 파일을 복사해 .env 로 두고 채운다) ===
# clone 후 아래 키만 자기 것으로 바꾸면 그대로 동작한다.

# --- LLM/임베딩 공통: SSAFY GMS(API 게이트웨이) ---
# 2026-07-20부터 이 프로젝트의 LLM·임베딩 호출은 전부 GMS 경유로 통일한다.
# GMS_KEY 하나로 LLM(chat/completions)과 임베딩(embeddings) 둘 다 인증한다.
GMS_KEY=

# LLM 제공자: openai(GMS, 기본) | anthropic | claude_code | codex(OAuth).
LLM_PROVIDER=openai

# GMS 경유 채팅 엔드포인트 base URL. 반드시 https://gms.ssafy.io/gmsapi/ 로 시작해야 한다.
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# GMS로 호출할 모델명
LLM_MODEL=gpt-4.1-mini

# --- Anthropic 직접 호출용(LLM_PROVIDER=anthropic 일 때만 사용) ---
# Anthropic API 키 — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 사용할 모델 (미설정 시 코드 기본값: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 샘플링 온도. 비워두면 모델 기본값 사용(opus-4-8 등 일부 모델은 temperature 미지원)
LLM_TEMPERATURE=0.3

# 응답 meta.modelVersion 에 기록되는 버전 태그
MODEL_VERSION=jarvis-0.1.0

# RAG 제공자. 기본 null(미연결) — RAG 담당자가 붙이면 provider 명으로 교체
RAG_PROVIDER=null
# Airflow 스택의 RAG 검색 서버와 연결할 때:
# RAG_PROVIDER=http
# RAG_SEARCH_URL=http://127.0.0.1:8765

# --- 임베딩 (gap_matcher 2차 매칭, skill_taxonomy 유사도 폴백, domain_keyword 등) ---
# "openai" = GMS 경유 OpenAI 임베딩(text-embedding-3-small). 기본 null(미연결)
EMBED_PROVIDER=openai

# GMS 경유 임베딩 엔드포인트 base URL. 반드시 https://gms.ssafy.io/gmsapi/ 로 시작해야 한다.
EMBED_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# 임베딩 모델명
EMBED_MODEL=text-embedding-3-large

# 토큰 비용 절감 — 모든 LLM 호출을 경량 모델 하나로 통일 (2026-07-27)
LLM_MODEL_LIGHT=gpt-4.1-mini
LLM_MAX_TOKENS=4096

# ── Claude Code CLI 공급자 (개발 반복용 — GMS 토큰 비용 없음) ──────────────
# 이 머신에 로그인된 Claude 구독(팀 플랜)의 Claude Code CLI 로 LLM 을 호출한다.
# 키가 아니라 `claude` 로그인 세션을 쓰므로, 로그인된 개발 머신에서만 동작한다.
# LLM_PROVIDER=claude_code
# CLAUDE_CLI=claude                # CLI 명령. WSL 밖에서 WSL 의 것을 쓰려면 "wsl claude"
# CLAUDE_CODE_MODEL=sonnet         # 고급 티어(추출·생성)
# CLAUDE_CODE_MODEL_LIGHT=haiku    # 경량 티어(분류·이진판정)

# ── Codex OAuth 공급자 (AI 패키지 내부 구현) ─────────────────────────────
# GMS에서 쓰던 노드별 system 지침과 human 입력은 수정 없이 instructions/input으로 전달된다.
# 최초 1회: uv run jobis-codex-oauth --login
# LLM_PROVIDER=codex               # gpt도 같은 alias
# CODEX_MODEL=gpt-5.4              # 고급 티어(추출·생성)
# CODEX_MODEL_LIGHT=gpt-5.4        # 경량 티어(분류·이진판정)
# CODEX_MODEL_ROUTER=              # 비우면 CODEX_MODEL 사용
# CODEX_REASONING_EFFORT=medium    # minimal|low|medium|high|xhigh|max|ultra
# CODEX_TIMEOUT_SEC=200
# CODEX_OAUTH_STATE_DIR=           # 운영에서는 영속 볼륨의 명시적 경로 사용
