# GMS (SSAFY Gen AI Management System) 설정 템플릿
# 사용법: 이 파일을 복사해 `.env`로 만들고 GMS_KEY를 채우세요.
#   (.env는 .gitignore로 커밋되지 않습니다. GMS_KEY를 절대 커밋하지 마세요.)

# 발급받은 GMS Key (Bearer 토큰)
GMS_KEY=your-gms-key-here

# GMS OpenAI-compat 엔드포인트 (보통 그대로 둡니다)
OPENAI_API_BASE=https://gms.ssafy.io/gmsapi/api.openai.com/v1
