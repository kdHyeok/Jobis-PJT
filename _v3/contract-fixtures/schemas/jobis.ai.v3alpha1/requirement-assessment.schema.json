{
  "$defs": {
    "AssessmentBasis": {
      "enum": [
        "VERIFIED_COMPETENCY",
        "VERIFIED_FORMAL_FACT",
        "VERIFIED_PARTIAL",
        "CAREER_EVIDENCE",
        "USER_CLAIM",
        "EXPLICIT_ABSENCE",
        "VERIFIED_INSUFFICIENCY",
        "NO_INFORMATION",
        "POLICY_NOT_APPLICABLE"
      ],
      "title": "AssessmentBasis",
      "type": "string"
    },
    "RequirementStatus": {
      "enum": [
        "VERIFIED_MET",
        "EVIDENCED",
        "CLAIMED_ONLY",
        "PARTIAL",
        "NOT_MET",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "RequirementStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "requirementId": {
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Requirementid",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RequirementStatus"
    },
    "required": {
      "title": "Required",
      "type": "boolean"
    },
    "includedInDenominator": {
      "title": "Includedindenominator",
      "type": "boolean"
    },
    "basis": {
      "$ref": "#/$defs/AssessmentBasis"
    },
    "matchedCompetencies": {
      "items": {
        "minLength": 3,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
        "type": "string"
      },
      "title": "Matchedcompetencies",
      "type": "array"
    },
    "matchedFormalFacts": {
      "items": {
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Matchedformalfacts",
      "type": "array"
    },
    "userEvidenceRefs": {
      "items": {
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Userevidencerefs",
      "type": "array"
    },
    "postingEvidenceIds": {
      "items": {
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Postingevidenceids",
      "type": "array"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    }
  },
  "required": [
    "requirementId",
    "status",
    "required",
    "includedInDenominator",
    "basis",
    "postingEvidenceIds",
    "reason",
    "confidence"
  ],
  "title": "RequirementAssessment",
  "type": "object"
}
