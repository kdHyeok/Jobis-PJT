{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "SOURCE_FETCH_FAILED",
        "SOURCE_EXTRACTION_LOW_CONFIDENCE",
        "SOURCE_NOT_VERIFIED",
        "POSTING_STRUCTURE_INVALID",
        "AMBIGUITY_UNRESOLVED",
        "AI_PROVIDER_NOT_CONFIGURED",
        "AI_TIMEOUT",
        "AI_PROVIDER_UNAVAILABLE",
        "CONTRACT_VALIDATION_FAILED",
        "ANALYSIS_CANCELLED",
        "ANALYSIS_STALE_RESULT",
        "UNAUTHORIZED_AI_CLIENT",
        "CAPABILITY_NOT_AVAILABLE",
        "UNSUPPORTED_CONTRACT_VERSION"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "requestId": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requestid"
        },
        "traceId": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceid"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorDetail",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "default": "jobis.ai.v3alpha1",
      "title": "Contractversion",
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/ErrorDetail"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}
