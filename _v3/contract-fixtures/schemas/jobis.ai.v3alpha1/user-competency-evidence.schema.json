{
  "$defs": {
    "ClaimState": {
      "enum": [
        "CLAIMED",
        "NOT_CLAIMED",
        "UNKNOWN"
      ],
      "title": "ClaimState",
      "type": "string"
    },
    "EvidenceState": {
      "enum": [
        "EVIDENCED",
        "NO_EVIDENCE",
        "UNKNOWN"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "VerificationState": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "NOT_VERIFIED",
        "NOT_APPLICABLE"
      ],
      "title": "VerificationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A user-scoped competency state supplied by Spring.\n\nThis object deliberately keeps a claim, supporting evidence, and a passed\nverification as three independent dimensions. The AI service never upgrades\none dimension merely because another is present.",
  "properties": {
    "competencyId": {
      "minLength": 3,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "title": "Competencyid",
      "type": "string"
    },
    "displayName": {
      "minLength": 1,
      "title": "Displayname",
      "type": "string"
    },
    "scopeDefinition": {
      "minLength": 1,
      "title": "Scopedefinition",
      "type": "string"
    },
    "claimState": {
      "$ref": "#/$defs/ClaimState"
    },
    "evidenceState": {
      "$ref": "#/$defs/EvidenceState"
    },
    "verificationState": {
      "$ref": "#/$defs/VerificationState"
    },
    "claimedLevel": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimedlevel"
    },
    "verifiedLevel": {
      "default": 0,
      "maximum": 5,
      "minimum": 0,
      "title": "Verifiedlevel",
      "type": "integer"
    },
    "evidenceRefs": {
      "items": {
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidencerefs",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    }
  },
  "required": [
    "competencyId",
    "displayName",
    "scopeDefinition",
    "claimState",
    "evidenceState",
    "verificationState",
    "confidence"
  ],
  "title": "UserCompetencyEvidence",
  "type": "object"
}
