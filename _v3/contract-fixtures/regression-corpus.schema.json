{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobis.local/schemas/regression-corpus.schema.json",
  "title": "JOBIS AI v3 regression corpus",
  "type": "object",
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "category",
        "title",
        "fixtureType",
        "input",
        "expected",
        "forbidden",
        "provenance"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "category": {
          "enum": [
            "ROLE",
            "EXPERIENCE",
            "SOURCE",
            "REQUIREMENT",
            "FIT",
            "ROADMAP",
            "ASYNC",
            "UI",
            "SECURITY"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "fixtureType": {
          "enum": ["USER_PROVIDED_EXCERPT", "SYNTHETIC_MINIMAL", "STATE_SCENARIO"]
        },
        "input": {"type": "object"},
        "expected": {"type": "object", "minProperties": 1},
        "forbidden": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "provenance": {
          "type": "object",
          "required": ["kind", "reference", "containsPersonalData"],
          "properties": {
            "kind": {
              "enum": ["USER_REPORTED_REGRESSION", "USER_PROVIDED_SOURCE", "PRODUCT_DECISION"]
            },
            "reference": {"type": "string", "minLength": 1},
            "containsPersonalData": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}

