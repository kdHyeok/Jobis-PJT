  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.0.0"
  }
