# 루트 Docker Compose(compose.yaml, 프로젝트 jobis-app)용 로컬 예제.
#   cp .env.compose-local.example .env
# compose.yaml 에는 env_file 이 없다. 이 파일은 Compose 가 프로젝트 디렉터리의 .env 로
# 자동으로 읽어 ${VAR} 를 채운다. 따라서 Docker 실행에 필요한 .env 는 두 개뿐이다:
# 이 파일(루트)과 infra/airflow/.env (Airflow·RAG 묶음).
#
# compose.yaml 이 참조하지 않는 변수는 컨테이너에 닿지 않는다 — 아래 마지막 절 참고.

POSTGRES_DB=jobiss
POSTGRES_MIGRATOR_USER=jobiss_migrator
POSTGRES_MIGRATOR_PASSWORD=local-migrator-password-change-me
POSTGRES_APP_USER=jobiss_app
POSTGRES_APP_PASSWORD=local-app-password-change-me

JWT_SECRET=local-compose-jwt-secret-at-least-32-bytes-change-me
AI_SHARED_SECRET=local-compose-ai-secret-at-least-32-bytes-change-me
AI_HTTP_TIMEOUT_SECONDS=660
AI_MAX_CONCURRENT_ANALYSES=2

# 팀 표준 프로바이더는 Anthropic API 직접 호출이다(D140). 키만 채우면 된다.
# 다른 provider 로 바꿀 때만 아래 해당 블록의 값을 채운다.
#
# 주의: AI 는 고급/경량/라우터 3티어를 쓰지만 compose.yaml 은 ANTHROPIC_MODEL 하나만
# 전달한다. ANTHROPIC_MODEL_LIGHT/_ROUTER 는 빈 값으로 남아 고급 티어로 폴백하므로
# Docker 에서는 아래 한 모델이 전 티어에 쓰인다. 라우팅(플래너) 오판은 턴 전체를 낭비하니
# Docker 로 돌릴 때는 경량 모델보다 상위 모델을 지정하는 편이 낫다.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# openai(GMS) 경로
GMS_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_MODEL_LIGHT=gpt-4.1-mini
LLM_MAX_TOKENS=4096

# codex(OAuth) 경로. 컨테이너 안에서 1회 로그인해야 하며 상태는 AI 볼륨의
# /var/lib/jobis-ai/codex 에 남는다. 절차는 RUN.md 8장.
CODEX_MODEL=gpt-5.4
CODEX_MODEL_LIGHT=gpt-5.4
CODEX_MODEL_ROUTER=
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SEC=200

# RAG 검색. infra/airflow 묶음을 띄우지 않았으면 null 로 둔다.
# 연결할 때만 http 로 바꾼다 — 컨테이너에서 호스트를 보므로 host.docker.internal 이다.
RAG_PROVIDER=null
RAG_SEARCH_URL=http://host.docker.internal:8765

# 공고 원문이 JS 로 렌더되는 페이지용 폴백. 키가 없으면 해당 폴백만 건너뛴다.
JOBIS_JINA_ENABLED=true
JINA_API_KEY=
JOBIS_FIRECRAWL_ENABLED=true
FIRECRAWL_API_KEY=
JOBIS_TAVILY_ENABLED=true
TAVILY_API_KEY=

# 이미지 기반 공고 OCR/VLM. 키가 없으면 비활성이다.
CLOVA_API_KEY=
CLOVA_VLM_URL=https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005

ALLOWED_ORIGINS=http://localhost:8088
COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=local
JOBISS_HTTP_PORT=8088
JOBISS_LOG_LEVEL=INFO

# 같은 호스트에 다른 브랜치 스택을 병렬로 띄우면 세션 쿠키가 서로를 덮어 로그인이 풀린다.
# 그럴 때만 스택마다 다른 이름을 준다.
# AUTH_COOKIE_NAME=jobiss_access

# --- compose.yaml 이 backend 로 전달하지 않는 값 ------------------------------
# 운영(ops/docker-compose.prod.yml)은 env_file 로 /etc/jobis/jobis-v2.env 를 통째로
# 넘기지만, 루트 compose.yaml 은 environment: 허용목록 방식이라 아래 값들이 컨테이너에
# 닿지 않는다. 즉 로컬 Docker 에서는 비밀번호 재설정 메일과 저장소 토큰 암호화가
# 애플리케이션 기본값으로 동작한다. 로컬에서 이 기능을 실제로 시험하려면
# compose.yaml 의 backend environment 에 전달을 추가하는 MR 이 필요하다(Infra 리뷰).
# 값 자체는 .env.production.example 이 정본이다.
#   PUBLIC_APP_URL / PASSWORD_RESET_* / MAIL_* / REPOSITORY_TOKEN_ENCRYPTION_KEY
#   SENSITIVE_DATA_ENCRYPTION_KEY / SENSITIVE_DATA_FINGERPRINT_KEY
