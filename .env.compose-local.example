POSTGRES_DB=jobiss
POSTGRES_MIGRATOR_USER=jobiss_migrator
POSTGRES_MIGRATOR_PASSWORD=local-migrator-password-change-me
POSTGRES_APP_USER=jobiss_app
POSTGRES_APP_PASSWORD=local-app-password-change-me

JWT_SECRET=local-compose-jwt-secret-at-least-32-bytes-change-me
AI_SHARED_SECRET=local-compose-ai-secret-at-least-32-bytes-change-me
AI_HTTP_TIMEOUT_SECONDS=660
AI_MAX_CONCURRENT_ANALYSES=2
REPOSITORY_TOKEN_ENCRYPTION_KEY=local-repository-encryption-key-at-least-32-bytes
PUBLIC_APP_URL=http://localhost:8288
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_CONSOLE_DELIVERY=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@jobis.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
LLM_PROVIDER=openai
GMS_KEY=replace-with-your-gms-key
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_MODEL_LIGHT=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
RAG_PROVIDER=null

# Exact-URL extraction fallbacks for pages whose job text is rendered in JS.
JOBIS_JINA_ENABLED=true
JINA_API_KEY=
JOBIS_FIRECRAWL_ENABLED=true
FIRECRAWL_API_KEY=
JOBIS_TAVILY_ENABLED=true
TAVILY_API_KEY=

ALLOWED_ORIGINS=http://localhost:8288
COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=local
JOBISS_HTTP_PORT=8288
