JOBIS_ENV=local
JOBIS_AI_SHARED_SECRET=local-ai-v3-secret
JOBIS_AI_HOST=127.0.0.1
JOBIS_AI_PORT=8300

# Local structured-analysis provider. Codex CLI reuses `codex login`.
LLM_PROVIDER=codex_cli
CODEX_CLI=codex
CODEX_MODEL=gpt-5.6-luna
JOBIS_LLM_EFFORT=low
JOBIS_LLM_RETRY_EFFORT=medium
JOBIS_LLM_TIMEOUT_SECONDS=420
JOBIS_LLM_MAX_ATTEMPTS=2

# Future GMS switch: set LLM_PROVIDER=openai and configure these values.
LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
GMS_KEY=

# Optional source acquisition providers.
# Jina Reader is used as a fallback when a job posting URL has too little text.
JOBIS_JINA_ENABLED=true
JINA_API_KEY=

# CLOVA Studio VLM is required for image-based job postings.
CLOVA_API_KEY=
CLOVA_VLM_URL=https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005
