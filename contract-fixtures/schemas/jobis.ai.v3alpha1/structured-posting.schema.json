{
  "$defs": {
    "Ambiguity": {
      "additionalProperties": false,
      "properties": {
        "ambiguityId": {
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Ambiguityid",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/AmbiguityType"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "candidateIds": {
          "items": {
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Candidateids",
          "type": "array"
        },
        "evidenceIds": {
          "items": {
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClarificationQuestion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ambiguityId",
        "type",
        "blocking",
        "reason",
        "evidenceIds"
      ],
      "title": "Ambiguity",
      "type": "object"
    },
    "AmbiguityType": {
      "enum": [
        "SOURCE_VERIFICATION",
        "POSITION_SELECTION",
        "EXPERIENCE_TRACK_SELECTION",
        "EXPERIENCE_CONFLICT",
        "REQUIREMENT_SCOPE",
        "USER_EVIDENCE",
        "OTHER"
      ],
      "title": "AmbiguityType",
      "type": "string"
    },
    "AtomicRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirementId": {
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Requirementid",
          "type": "string"
        },
        "sourceText": {
          "minLength": 1,
          "title": "Sourcetext",
          "type": "string"
        },
        "atomicText": {
          "minLength": 1,
          "title": "Atomictext",
          "type": "string"
        },
        "obligation": {
          "$ref": "#/$defs/RequirementObligation"
        },
        "category": {
          "$ref": "#/$defs/RequirementCategory"
        },
        "appliesToPositionIds": {
          "items": {
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Appliestopositionids",
          "type": "array"
        },
        "evidenceIds": {
          "items": {
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "normalizationStatus": {
          "$ref": "#/$defs/NormalizationStatus",
          "default": "PENDING"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/WarningItem"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "requirementId",
        "sourceText",
        "atomicText",
        "obligation",
        "category",
        "appliesToPositionIds",
        "evidenceIds",
        "confidence"
      ],
      "title": "AtomicRequirement",
      "type": "object"
    },
    "ClarificationQuestion": {
      "additionalProperties": false,
      "properties": {
        "inputType": {
          "$ref": "#/$defs/QuestionInputType"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/QuestionOption"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "inputType",
        "text"
      ],
      "title": "ClarificationQuestion",
      "type": "object"
    },
    "CompanyCandidate": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "canonicalCompanyId": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonicalcompanyid"
        },
        "evidenceIds": {
          "items": {
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "displayName",
        "evidenceIds",
        "confidence"
      ],
      "title": "CompanyCandidate",
      "type": "object"
    },
    "ExperienceKind": {
      "enum": [
        "NEW_GRADUATE",
        "EXPERIENCE_REQUIRED",
        "RANGE",
        "NO_RESTRICTION",
        "NEW_GRADUATE_OR_EXPERIENCED",
        "UNKNOWN"
      ],
      "title": "ExperienceKind",
      "type": "string"
    },
    "ExperienceRequirement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExperienceKind"
        },
        "minMonths": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minmonths"
        },
        "maxMonths": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxmonths"
        },
        "experiencedMinMonths": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiencedminmonths"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidenceIds": {
          "items": {
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "confidence",
        "evidenceIds"
      ],
      "title": "ExperienceRequirement",
      "type": "object"
    },
    "NormalizationStatus": {
      "enum": [
        "PENDING",
        "KNOWN",
        "NEW_CANDIDATE",
        "NOT_APPLICABLE"
      ],
      "title": "NormalizationStatus",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "positionId": {
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Positionid",
          "type": "string"
        },
        "sourceTitle": {
          "minLength": 1,
          "title": "Sourcetitle",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/RoleCandidate"
        },
        "experience": {
          "$ref": "#/$defs/ExperienceRequirement"
        },
        "responsibilities": {
          "items": {
            "$ref": "#/$defs/Responsibility"
          },
          "title": "Responsibilities",
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/AtomicRequirement"
          },
          "title": "Requirements",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/WarningItem"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "positionId",
        "sourceTitle",
        "role",
        "experience"
      ],
      "title": "Position",
      "type": "object"
    },
    "PostingStatus": {
      "enum": [
        "ACTIVE",
        "CLOSED",
        "UNKNOWN"
      ],
      "title": "PostingStatus",
      "type": "string"
    },
    "QuestionInputType": {
      "enum": [
        "CHOICE",
        "TEXT"
      ],
      "title": "QuestionInputType",
      "type": "string"
    },
    "QuestionOption": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Value",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "QuestionOption",
      "type": "object"
    },
    "RequirementCategory": {
      "enum": [
        "TECHNOLOGY",
        "TECHNICAL_CAPABILITY",
        "RESPONSIBILITY",
        "DOMAIN_KNOWLEDGE",
        "CREDENTIAL",
        "EXPERIENCE",
        "PORTFOLIO",
        "BEHAVIORAL",
        "EMPLOYMENT_CONDITION",
        "OTHER"
      ],
      "title": "RequirementCategory",
      "type": "string"
    },
    "RequirementObligation": {
      "enum": [
        "REQUIRED",
        "PREFERRED",
        "INFORMATIONAL"
      ],
      "title": "RequirementObligation",
      "type": "string"
    },
    "Responsibility": {
      "additionalProperties": false,
      "properties": {
        "responsibilityId": {
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Responsibilityid",
          "type": "string"
        },
        "sourceText": {
          "minLength": 1,
          "title": "Sourcetext",
          "type": "string"
        },
        "atomicText": {
          "minLength": 1,
          "title": "Atomictext",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "responsibilityId",
        "sourceText",
        "atomicText",
        "evidenceIds",
        "confidence"
      ],
      "title": "Responsibility",
      "type": "object"
    },
    "RoleCandidate": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "specialization": {
          "minLength": 1,
          "title": "Specialization",
          "type": "string"
        },
        "canonicalRoleId": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonicalroleid"
        },
        "status": {
          "$ref": "#/$defs/RoleStatus"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidenceIds": {
          "items": {
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        }
      },
      "required": [
        "family",
        "specialization",
        "status",
        "confidence",
        "evidenceIds"
      ],
      "title": "RoleCandidate",
      "type": "object"
    },
    "RoleStatus": {
      "enum": [
        "CANDIDATE",
        "CONFIRMED",
        "NEW_CANDIDATE",
        "UNKNOWN"
      ],
      "title": "RoleStatus",
      "type": "string"
    },
    "WarningItem": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/WarningSeverity",
          "default": "WARNING"
        },
        "evidenceIds": {
          "items": {
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidenceids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "WarningItem",
      "type": "object"
    },
    "WarningSeverity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR"
      ],
      "title": "WarningSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "default": "jobis.ai.v3alpha1",
      "title": "Contractversion",
      "type": "string"
    },
    "analysisVersion": {
      "minLength": 1,
      "title": "Analysisversion",
      "type": "string"
    },
    "verifiedSnapshotId": {
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Verifiedsnapshotid",
      "type": "string"
    },
    "company": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompanyCandidate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "postingTitle": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Postingtitle"
    },
    "postingTitleEvidenceIds": {
      "items": {
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Postingtitleevidenceids",
      "type": "array"
    },
    "positions": {
      "items": {
        "$ref": "#/$defs/Position"
      },
      "minItems": 1,
      "title": "Positions",
      "type": "array"
    },
    "sharedConditions": {
      "items": {
        "$ref": "#/$defs/AtomicRequirement"
      },
      "title": "Sharedconditions",
      "type": "array"
    },
    "applicationDeadline": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicationdeadline"
    },
    "applicationDeadlineEvidenceIds": {
      "items": {
        "minLength": 3,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Applicationdeadlineevidenceids",
      "type": "array"
    },
    "postingStatus": {
      "$ref": "#/$defs/PostingStatus",
      "default": "UNKNOWN"
    },
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/Ambiguity"
      },
      "title": "Ambiguities",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/WarningItem"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "analysisVersion",
    "verifiedSnapshotId",
    "positions"
  ],
  "title": "StructuredPosting",
  "type": "object"
}
