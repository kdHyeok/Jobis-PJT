# Local development configuration. Copy this file to .env and fill in local-only values.
# 이 파일을 .env로 복사한 뒤 본인 로컬 값을 채우세요. (.env는 Git에서 무시됩니다)

DB_URL=jdbc:mysql://localhost:3306/jobiss?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# 주의: JWT_SECRET은 반드시 32자(256비트) 이상이어야 합니다. 짧으면 서버가 시작되지 않습니다.
# 생성 예시 (PowerShell): [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# 생성 예시 (macOS/Linux): openssl rand -base64 48
JWT_SECRET=
