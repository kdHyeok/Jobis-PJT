# 이 파일을 .env로 복사한 뒤 본인 로컬 값을 채우세요. (.env는 Git에서 무시됨 — .gitignore 확인)
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS/Linux:        cp .env.example .env
# ※ 하서진 님 파트는 PostgreSQL 기준 예시입니다(팀 develop의 예시는 MySQL — DB 마이그레이션 반영 시 함께 교체).

DB_URL=jdbc:postgresql://localhost:5432/jobiss
DB_USERNAME=jobiss
DB_PASSWORD=

# JWT_SECRET은 반드시 32자(256비트) 이상. 짧으면 서버가 WeakKeyException으로 시작 실패.
#   생성(PowerShell): [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   생성(macOS/Linux): openssl rand -base64 48
JWT_SECRET=

# 선택(기본값 localhost:8000이라 보통 생략):
# AGENT_WS_URL=ws://localhost:8000
# AGENT_HTTP_URL=http://localhost:8000
