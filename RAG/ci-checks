#!/usr/bin/env bash
# RAG·DATA 영역 CI 검사. **이 파일은 RAG 담당자가 고친다.**
#
#   ./RAG/ci-checks test   # 필수 — 컴파일 + 단위 테스트(무거운 의존성 없이)
#   ./RAG/ci-checks lint   # 권고 — ruff
#
# 여기서 도는 테스트는 numpy·rank_bm25·psycopg·python-dotenv 만으로 통과해야 한다.
# 임베딩 백엔드나 pgvector 가 필요한 코드는 테스트에서 직접 import 하지 말고,
# 순수 계산을 별도 모듈로 떼어 그것을 테스트한다(jobrag/ingest_windows.py 참고).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

venv="${RAG_CI_VENV:-/tmp/jobis-rag-venv}"
if [ ! -x "$venv/bin/python" ]; then
  python -m venv "$venv"
  "$venv/bin/python" -m pip install --disable-pip-version-check --no-cache-dir \
    numpy==2.2.6 rank_bm25==0.2.2 'psycopg[binary]==3.2.9' python-dotenv==1.1.1
fi

case "${1:-test}" in
  test)
    "$venv/bin/python" -m compileall -q RAG
    "$venv/bin/python" -m unittest discover -s RAG/tests -v
    ;;
  lint)
    "$venv/bin/python" -m pip install --disable-pip-version-check --no-cache-dir -q ruff==0.14.5
    "$venv/bin/python" -m ruff check RAG DATA
    ;;
  *) echo "사용법: $0 [test|lint]" >&2; exit 2 ;;
esac
